---
import { SITE } from "@/config";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Remove current url path, base prefix, and trailing slash
let currentUrlPath = Astro.url.pathname.replace(/\/+$/, "");
if (base && currentUrlPath.startsWith(base)) {
  currentUrlPath = currentUrlPath.slice(base.length);
}

// Get url array from path
// eg: /topics/sql-injection-deep-dive => ['topics', 'sql-injection-deep-dive']
const breadcrumbList = currentUrlPath.split("/").filter(Boolean);

// if breadcrumb is Home > Posts > 1 <etc>
// replace Posts with Posts (page number)
if (breadcrumbList[0] === "posts") {
  breadcrumbList.splice(0, 2, `Posts (page ${breadcrumbList[1] || 1})`);
}

const origin = new URL(SITE.website).origin;
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL(`${base}/`, origin).href,
    },
    ...breadcrumbList.map((label, index) => {
      const isLast = index + 1 === breadcrumbList.length;
      return {
        "@type": "ListItem",
        position: index + 2,
        name: decodeURIComponent(label),
        item: isLast
          ? new URL(`${base}${currentUrlPath}/`, origin).href
          : new URL(`${base}/${label}/`, origin).href,
      };
    }),
  ],
};
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(breadcrumbSchema)}
/>

<nav class="app-layout mt-8 mb-1" aria-label="breadcrumb">
  <ul
    class="font-light [&>li]:inline [&>li:not(:last-child)>a]:hover:opacity-100"
  >
    <li>
      <a href={`${base}/`} class="opacity-80">Home</a>
      <span aria-hidden="true" class="opacity-80">&raquo;</span>
    </li>
    {
      breadcrumbList.map((breadcrumb, index) =>
        index + 1 === breadcrumbList.length ? (
          <li>
            <span
              class:list={["capitalize opacity-75", { lowercase: index > 0 }]}
              aria-current="page"
            >
              {/* make the last part lowercase in Home > Topics > some-topic */}
              {decodeURIComponent(breadcrumb)}
            </span>
          </li>
        ) : (
          <li>
            <a href={`${base}/${breadcrumb}/`} class="capitalize opacity-70">
              {breadcrumb}
            </a>
            <span aria-hidden="true">&raquo;</span>
          </li>
        )
      )
    }
  </ul>
</nav>
