# Filters a local build context only: BuildKit skips this file for a Git
# context, which the published image builds from. A tracked path excluded here
# must be excluded by the Dockerfile too, or the two images drift.
node_modules/
.next/
.git/
.env
prisma/*.db
prisma/*.db-journal
uploads/
documents/invoices/
coverage/
cypress/screenshots/
cypress/videos/
cypress/downloads/
logs/
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
docs/
# ...except the curriculum, which the image ships on its own.
!docs/src/data/roadmap.ts
packages/create-oss-store/
tests/
cypress/
.cursor/
.husky/
prisma/*.pem
# Untracked local tooling, absent from any CI build: keeps a locally built
# image identical to the published one.
.claude/
.plan/
.venv/
*.tsbuildinfo
